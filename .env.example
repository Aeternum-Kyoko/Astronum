# SQLite database file
DATABASE_URL="file:./dev.db"

# Long random string for signing session cookies: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# bcrypt hash of the /admin password: node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
ADMIN_PASSWORD_HASH=""

# Public origin used for the sitemap, canonical URLs and share images
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Transactional email (password reset) via https://resend.com — without these, dev logs emails to the console
RESEND_API_KEY=""
EMAIL_FROM="Astronum <no-reply@yourdomain.com>"

# Paid consultations via Razorpay (leave empty to keep the free request form). Set prices in src/lib/consultationPlans.ts.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Where new-booking notifications go
ADMIN_NOTIFY_EMAIL=""

# Protects the daily email job (/api/cron/daily). Vercel Cron sends it automatically as a Bearer token.
CRON_SECRET=""
